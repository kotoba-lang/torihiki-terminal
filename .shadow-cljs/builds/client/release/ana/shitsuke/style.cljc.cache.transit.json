omponents in\n  shitsuke.components carry stable class names `shitsuke__<component>`; a\n  consumer's :pages build adds `shitsuke.components` to shadow.css.build's\n  :include (see slides.build) so the `(css ...)` markers materialise scoped\n  rules. This namespace owns the class-name convention + a tiny registry so\n  tests can assert stable names without shadow-css at runtime.","~:file","shitsuke/style.cljc","~:line",1,"~:column",5,"~:end-line",1,"~:end-column",19],"~:ns-aliases",["^ ","~$cljs.loader","~$shadow.loader"],"~:use-macros",null,"~:excludes",["~#set",[]],"~:name","~$shitsuke.style","~:reader-aliases",["^ "],"~:op","~:ns","~:imports",null,"~:requires",["^ ","~$shitsuke.tokens","^I","~$t","^I","~$clojure.string","^J","~$str","^J","~$cljs.core","^L","~$goog","^M"],"~:seen",["^A",["~:require"]],"~:uses",null,"~:require-macros",["^ ","^L","^L"],"~:form",["~#list",["~$ns","^C","Two-tier styling layer.\n\n  Tier A (portable, this namespace): token → CSS custom properties on :root.\n  `root-css` returns the `:root{...}` string; `inline-style` wraps it in a\n  <style> tag for SSR. babashka-safe, zero dep.\n\n  Tier B (build-time, shadow-css): scoped class CSS. Components in\n  shitsuke.components carry stable class names `shitsuke__<component>`; a\n  consumer's :pages build adds `shitsuke.components` to shadow.css.build's\n  :include (see slides.build) so the `(css ...)` markers materialise scoped\n  rules. This namespace owns the class-name convention + a tiny registry so\n  tests can assert stable names without shadow-css at runtime.",["^S",["^O",["^I","~:as","~$t"],["^J","^U","^K"]]]]],"~:flags",["^ ","^O",["^A",[]]],"~:js-deps",[],"~:deps",["^M","^L","^I","^J"]],"^F","^C","~:resource-id",["~:shadow.build.classpath/resource","shitsuke/style.cljc"],"~:compiled-at",1785577559716,"^D",["^ ","^I","^I","~$t","^I","^J","^J","^K","^J","^L","^L","^M","^M"],"~:resource-name","shitsuke/style.cljc","~:warnings",[],"~:source","(ns shitsuke.style\n  \"Two-tier styling layer.\n\n  Tier A (portable, this namespace): token → CSS custom properties on :root.\n  `root-css` returns the `:root{...}` string; `inline-style` wraps it in a\n  <style> tag for SSR. babashka-safe, zero dep.\n\n  Tier B (build-time, shadow-css): scoped class CSS. Components in\n  shitsuke.components carry stable class names `shitsuke__<component>`; a\n  consumer's :pages build adds `shitsuke.components` to shadow.css.build's\n  :include (see slides.build) so the `(css ...)` markers materialise scoped\n  rules. This namespace owns the class-name convention + a tiny registry so\n  tests can assert stable names without shadow-css at runtime.\"\n  (:require [shitsuke.tokens :as t]\n            [clojure.string :as str]))\n\n(defn class-name\n  \"Stable scoped class for a component: `shitsuke__button`. Used both as the\n  hiccup :class and as the shadow-css extraction anchor.\"\n  [component]\n  (str \"shitsuke__\" (name component)))\n\n(defn root-css\n  \":root{...} CSS string from tokens (default merged with overrides).\"\n  ([]\n   (t/css-variables))\n  ([overrides]\n   (t/css-variables overrides)))\n\n(defn inline-style\n  \"Wrap a CSS string in a <style> tag for inline SSR embedding.\"\n  ([]\n   (inline-style (root-css)))\n  ([css]\n   (str \"<style>\\n\" css \"\\n</style>\")))\n\n(defn inline-style-hiccup\n  \"Hiccup form of inline-style: [:style [:hiccup/raw css]] (the raw form is\n  understood by shitsuke.hiccup/->html so the CSS is not escaped).\"\n  ([]\n   (inline-style-hiccup (root-css)))\n  ([css]\n   [:style [:hiccup/raw css]]))\n","~:reader-features",["^A",["~:cljs"]],"~:used-var-namespaces",["^A",["^I","^L","~$js","^C"]],"~:cljc",true,"~:source-map-compact",["^ ","mappings",";AAgBA;;;;4BAAA,5BAAMA,gEAGHC;AAHH,AAIE,QAAA,aAAkB,AAACC,eAAKD;;AAE1B,AAAA;;;0BAAA,kCAAAE,5DAAME;AAAN,AAAA,IAAAD,WAAA,AAAA;AAAA,AAAA,QAAAA;KAAA;AAAA,OAAAC;;;KAAA;AAAA,OAAAA,sDAAA,CAAA,UAAA;;;;AAAA,MAAA,KAAAC,MAAA,CAAA,8DAAA,AAAA;;;;;AAAA,CAAA,wDAAA,xDAAMD;AAAN,AAGG,OAACE;;;AAHJ,CAAA,