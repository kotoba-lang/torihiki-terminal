{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/clojurescript {:mvn/version "1.11.132"}
        thheller/shadow-cljs {:mvn/version "2.28.20"}
        ;; The engine, for torihiki.auth/signing-payload only. The browser must
        ;; produce the byte-identical string the node hashes, and the way to
        ;; guarantee that is to call the same function rather than to write a
        ;; second one in JavaScript and keep them in agreement by hand.
        io.github.kotoba-lang/torihiki
        {:git/url "https://github.com/kotoba-lang/torihiki.git"
         :git/sha "fa3a8e0cc213c8d2a11f7e521b3e38007749d83c"}
        io.github.kotoba-lang/kotoba-ui
        {:git/url "https://github.com/kotoba-lang/kotoba-ui.git"
         :git/sha "80445c9dbafef5402d1aee8409fb6fcfa35cef4d"}
        ;; The chart. Pure data -> SVG geometry, no DOM and no fetch, so the
        ;; server shell and the browser client build it with the same call —
        ;; the same property that let the JavaScript row-builder be deleted.
        ;;
        ;; It pulls kotoba-lang/d3 (a native cljc reimplementation of d3-scale
        ;; and d3-shape, not a wrapper around d3.js) transitively.
        ;; The skin. デジタル庁 DADS primitives plus the `--hig-*` bridge that
        ;; maps this page's token contract onto them — see torihiki-terminal.skin
        ;; for why it is a skin over kotoba-ui rather than a replacement of it.
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system.git"
         :git/sha "4324cc785792dac0c801ab17dcc22d2d03e24812"}
        io.github.kotoba-lang/torihiki-chart
        {:git/url "https://github.com/kotoba-lang/torihiki-chart.git"
         :git/sha "850fc19ac5e4774ad8fe4e153fb88599a70dc40a"}}
 :aliases
 {:build {:extra-paths ["script"] :main-opts ["-m" "build"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/url "https://github.com/cognitect-labs/test-runner.git"
                       :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
