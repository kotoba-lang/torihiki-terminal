{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/clojurescript {:mvn/version "1.11.132"}
        thheller/shadow-cljs {:mvn/version "2.28.20"}
        io.github.kotoba-lang/kotoba-ui
        {:git/url "https://github.com/kotoba-lang/kotoba-ui.git"
         :git/sha "80445c9dbafef5402d1aee8409fb6fcfa35cef4d"}}
 :aliases
 {:build {:extra-paths ["script"] :main-opts ["-m" "build"]}
