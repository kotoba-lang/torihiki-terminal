["^ ","~:output",["^ ","~:js","goog.provide('torihiki_terminal.config');\ntorihiki_terminal.config.tick_usd_cents = (10);\ntorihiki_terminal.config.lots_per_unit = (1000);\ntorihiki_terminal.config.market_id = (1);\ntorihiki_terminal.config.max_leverage = (40);\n/**\n * The BFT chain, not the single sequencer.\n * \n *   `torihiki-node` is one Durable Object deciding the order by itself and\n *   saying so at `/head`. `torihiki-validator` is four of them running\n *   `engi.replica` with the same engine as their state machine. The terminal\n *   pointed at the first one for as long as the second one did not work; two\n *   chains where there should be one is a question about which is real, and the\n *   answer should not be whichever the page happens to fetch.\n */\ntorihiki_terminal.config.node_url = \"https://torihiki-validator.04-feasts-minded.workers.dev\";\ntorihiki_terminal.config.witnesses = new cljs.core.PersistentVector(null, 4, 5, cljs.core.PersistentVector.EMPTY_NODE, [\"w1\",\"w2\",\"w3\",\"w4\"], null);\n","~:ns-info",["^ ","~:rename-macros",null,"~:renames",["^ "],"~:meta",["^ ","~:doc","The scale the node's market uses, and where the node is.\n\n  These are duplicated from `torihiki-node.worker`'s market definition, which\n  is a real coupling and is written down rather than hidden: the terminal\n  formats integer ticks into dollars, so it has to know what a tick is worth.\n  The node exposes `:tick` and `:lot` on `/market`, and the right fix is for\n  the client to take them from there rather than from a constant — a follow-up\n  that stops mattering only once it is done.","~:file","torihiki_terminal/config.cljc","~:line",1,"~:column",5,"~:end-line",1,"~:end-column",29],"~:ns-aliases",["^ ","~$cljs.loader","~$shadow.loader"],"~:use-macros",null,"~:excludes",["~#set",[]],"~:name","~$torihiki-terminal.config","~:reader-aliases",["^ "],"~:op","~:ns","~:imports",null,"~:requires",["^ ","~$cljs.core","^I","~$goog","^J"],"~:seen",["^A",[]],"~:uses",null,"~:require-macros",["^ ","^I","^I"],"~:form",["~#list",["~$ns","^C","The scale the node's market uses, and where the node is.\n\n  These are duplicated from `torihiki-node.worker`'s market definition, which\n  is a real coupling and is written down rather than hidden: the terminal\n  formats integer ticks into dollars, so it has to know what a tick is worth.\n  The node exposes `:tick` and `:lot` on `/market`, and the right fix is for\n  the client to take them from there rather than from a constant — a follow-up\n  that stops mattering only once it is done."]],"~:flags",["^ "],"~:js-deps",[],"~:deps",["^J","^I"]],"^F","^C","~:resource-id",["~:shadow.build.classpath/resource","torihiki_terminal/config.cljc"],"~:compiled-at",1785636871609,"^D",["^ ","^I","^I","^J","^J"],"~:resource-name","torihiki_terminal/config.cljc","~:warnings",[],"~:source","(ns torihiki-terminal.config\n  \"The scale the node's market uses, and where the node is.\n\n  These are duplicated from `torihiki-node.worker`'s market definition, which\n  is a real coupling and is written down rather than hidden: the terminal\n  formats integer ticks into dollars, so it has to know what a tick is worth.\n  The node exposes `:tick` and `:lot` on `/market`, and the right fix is for\n  the client to take them from there rather than from a constant — a follow-up\n  that stops mattering only once it is done.\")\n\n(def ^:const tick-usd-cents 10)\n(def ^:const lots-per-unit 1000)\n(def ^:const market-id 1)\n(def ^:const max-leverage 40)\n(def ^:const node-url\n  \"The BFT chain, not the single sequencer.\n\n  `torihiki-node` is one Durable Object deciding the order by itself and\n  saying so at `/head`. `torihiki-validator` is four of them running\n  `engi.replica` with the same engine as their state machine. The terminal\n  pointed at the first one for as long as the second one did not work; two\n  chains where there should be one is a question about which is real, and the\n  answer should not be whichever the page happens to fetch.\"\n  \"https://torihiki-validator.04-feasts-minded.workers.dev\")\n\n(def witnesses [\"w1\" \"w2\" \"w3\" \"w4\"])\n","~:reader-features",["^A",["~:cljs"]],"~:used-var-namespaces",["^A",["^C"]],"~:cljc",true,"~:source-map-compact",["^ ","mappings",";AAUA,0CAAA,1CAAaA;AACb,yCAAA,zCAAaC;AACb,qCAAA,rCAAaC;AACb,wCAAA,xCAAaC;AACb;;;;;;;;;;oCAAA,pCAAaC;AAWb,qCAAA,mFAAA,KAAA,KAAA,KAAA,vIAAKC","names",["torihiki-terminal.config/tick-usd-cents","torihiki-terminal.config/lots-per-unit","torihiki-terminal.config/market-id","torihiki-terminal.config/max-leverage","torihiki-terminal.config/node-url","torihiki-terminal.config/witnesses"]],"~:used-vars",["^A",["~$torihiki-terminal.config/lots-per-unit","~$torihiki-terminal.config/max-leverage","~$torihiki-terminal.config/tick-usd-cents","~$torihiki-terminal.config/node-url","~$torihiki-terminal.config/market-id","~$torihiki-terminal.config/witnesses"]]],"~:cache-keys",["~#cmap",[["^U","goog/dom/tagname.js"],["533ce2bdbb7925db781449abb6527af1e6c5e782","~:shadow.build.compiler/resolve",["^ ","~:require-id",null,"~:deps-ids",["^A",[]],"~:deps-syms",["^J","~$goog.dom.HtmlElement"]]],["^U","goog/html/trustedtypes.js"],["533ce2bdbb7925db781449abb6527af1e6c5e782","^1>",["^ ","^1?",null,"^1@",["^A",[]],"^1A",["^J"]]],["^U","goog/labs/useragent/browser.js"],["533ce2bdbb7925db781449abb6527af1e6c5e782","^1>",["^ ","^1?",null,"^1@",["^A",[]],"^1A",["^J","~$goog.labs.userAgent.util","~$goog.labs.userAgent.highEntropy.highEntropyValue","~$goog.asserts","~$goog.string.internal","~$goog.labs.userAgent.highEntropy.highEntropyData","~$goog.labs.userAgent"]]],["^U","goog/html/safeurl.js"],["533ce2bdbb7925db781449abb6527af1e6c5e782","^1>",["^ ","^1?",null,"^1@",["^A",[]],"^1A",["^J","^1E","~$goog.fs.url","~$goog.html.TrustedResourceUrl","~$goog.string.Const","~$goog.string.TypedString","^1F"]]],["^U","goog/array/array.js"],["533ce2bdbb7925db781449abb6527af1e6c5e782","^1>",["^ ","^1?",null,"^1@",["^A",[]],"^1A",["^J","^1E"]]],["